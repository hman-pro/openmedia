# Secrets — constitution: bot tokens and source credentials never reach version control.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets/

# Downloaded media and worker workspaces.
# Workers own a temporary work directory; its contents are never committed.
work/
downloads/
media/
*.mp4
*.mkv
*.webm
*.m4a
*.mp3
*.opus
# Sanitized tiny fixtures are versioned on purpose (T004).
!tests/fixtures/**

# Diagnostic logs — may contain links and Telegram identifiers (002, FR-016).
logs/
*.log

# Live-check artifacts — machine-local, may contain real URLs.
tests/live/manifest.local.*
specs/**/validation.local.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.specify/**
# uv.lock stays tracked: T002 pins the exact resolved dependency set.

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Agent and editor local state
.claude/
.vscode/
.idea/
*.swp
*.tmp
*.log

# OS metadata
.DS_Store
Thumbs.db
CLAUDE.md
AGENTS.md

# Feature 008 host deployment and release-acquisition state.
# No host credentials, live manifests, or media enter assets.
/deploy/deploy.env
/deploy/secrets/
/deploy/.state/
/deploy/state/
/deploy/evidence/
/deploy/updates/
/deploy/*.local.*
/release-output/
/source-collection/
/release/.state/
/release/evidence/
/release/sources/
/release/inventory/
*.credentials.json
.netrc
.docker/config.json
.gh/
# Keep deploy.env.example, reviewed release policies and sanitized fixtures available.

# Temporary CI/release staging; public sources are hosted as immutable release assets.
/checked/
/materials/
/output/
/controlled/
/release-assets/
/authority/
/release-tools/

# Notice generator scratch text; the reproducible gzip and provenance are tracked.
/release/runtime-notices.txt
