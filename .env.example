# Required at runtime. Keep the real value in the deployment secret store.
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# Optional bounded runtime settings.
OPENMEDIA_WORK_DIR=/tmp/openmedia
OPENMEDIA_MAX_FILE_BYTES=50000000
OPENMEDIA_MAX_WORKERS=2
OPENMEDIA_MAX_PENDING=100
OPENMEDIA_WORKSPACE_BYTES=134217728
OPENMEDIA_LOG_LEVEL=INFO

# Development-only diagnostic log (002). Off by default. When on, one JSON Lines file per
# UTC day is written, and it holds submitted links and Telegram chat/user identifiers.
# OPENMEDIA_DIAGNOSTIC_LOG=0
# Used only when the flag is 1. Absolute path outside OPENMEDIA_WORK_DIR; mount a volume here.
# OPENMEDIA_DIAGNOSTIC_LOG_DIR=/var/log/openmedia
# Used only when the flag is 1. CRITICAL, ERROR, WARNING, INFO, or DEBUG.
# OPENMEDIA_DIAGNOSTIC_LOG_LEVEL=DEBUG

# Inspection (60s), selection (900s), processing (600s), and cleanup (900s)
# deadlines are fixed acceptance values and deliberately have no environment variables.
