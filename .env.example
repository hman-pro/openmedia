# Required at runtime. Keep the real value in the deployment secret store.
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# Optional bounded runtime settings.
OPENMEDIA_WORK_DIR=/tmp/openmedia
OPENMEDIA_MAX_FILE_BYTES=50000000
OPENMEDIA_MAX_WORKERS=2
OPENMEDIA_MAX_PENDING=100
OPENMEDIA_WORKSPACE_BYTES=134217728
OPENMEDIA_LOG_LEVEL=INFO

# Inspection (60s), selection (900s), processing (600s), and cleanup (900s)
# deadlines are fixed acceptance values and deliberately have no environment variables.
