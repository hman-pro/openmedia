# Nonsecret Compose interpolation only; this is not a container env_file.
# Verify release signatures/identities first using deploy/README.md.
# Replace the placeholder: exact grammar is ghcr.io/hman-pro/openmedia@sha256:
# followed by exactly 64 hexadecimal digits. Tags and floating defaults are forbidden.
# Compose's :? syntax checks presence only; use the guide's digest check before pull.
OPENMEDIA_IMAGE=ghcr.io/hman-pro/openmedia@sha256:REPLACE_WITH_VERIFIED_64_HEX_INDEX_DIGEST
OPENMEDIA_TOKEN_FILE=/opt/openmedia/secrets/telegram_bot_token

# Explicitly mapped runtime settings; no host environment import or token value.
OPENMEDIA_MAX_FILE_BYTES=50000000
OPENMEDIA_MAX_WORKERS=2
OPENMEDIA_MAX_PENDING=100
OPENMEDIA_WORKSPACE_BYTES=134217728
OPENMEDIA_LOG_LEVEL=INFO
OPENMEDIA_DIAGNOSTIC_LOG=0
# Enabling diagnostics also requires a reviewed protected writable mount (feature 002).
OPENMEDIA_DIAGNOSTIC_LOG_DIR=/var/log/openmedia
OPENMEDIA_DIAGNOSTIC_LOG_LEVEL=DEBUG
# Work directory is fixed at /tmp/openmedia; deadlines are not configurable.
# Shell variables normally override this file; the guide clears inherited variables
# and supplies only the verified command-scoped OPENMEDIA_IMAGE override.
